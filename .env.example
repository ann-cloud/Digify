# Vercel Postgres / Neon connection strings
# Get these from Vercel Storage tab after creating a Postgres database
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# JWT secret — generate a long random string for production:
# openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Vercel Blob — file storage for product files and cover images
# After creating a Blob store in Vercel Storage tab, this is auto-injected.
# For local dev, run `vercel env pull .env.local` or copy the token from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"
